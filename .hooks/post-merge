#!/usr/bin/env bash
set -euo pipefail

# Always run from repo root (works regardless of where git was invoked from)
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "github.hook [post-merge] Decrypting .env.enc files after pull..."

./.scripts/runme.sh decrypt

echo "github.hook [post-merge] Environment files restored."